APP_NAME=Gestoque
APP_ENV=local
# Gere com: php artisan key:generate (no Laravel Cloud é criada automaticamente)
APP_KEY=
APP_DEBUG=true
# Precisa bater com o endereço usado no navegador, senão o logo não aparece.
APP_URL=http://127.0.0.1:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

# Dados da oficina (nome padrão quando o usuário não salvou empresa, catálogo e WhatsApp)
OFICINA_NOME="Moto Mecânica"
# Só números, com DDI e DDD. Ex.: 55 + DDD + número
OFICINA_WHATSAPP=5500000000000
OFICINA_ENDERECO="Cidade/UF"

# Administrador padrão: "php artisan gestoque:admin-padrao" cria esta conta
# somente se ainda não existir nenhum administrador. Nunca coloque a senha real aqui.
# ADMIN_NOME="Administrador"
# ADMIN_EMAIL=
# ADMIN_SENHA=

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Desenvolvimento: SQLite (arquivo database/database.sqlite).
# Produção (Laravel Cloud): pgsql; as variáveis DB_* são preenchidas pelo Cloud ao ligar o banco.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=gestoque
# DB_USERNAME=
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log

# Discos de arquivos.
# FILESYSTEM_DISK: disco padrão. Local: "local". No Cloud: o bucket privado "fiscal" (o Cloud define sozinho).
FILESYSTEM_DISK=local
# IMAGENS_DISK: logos (e futuras fotos de produtos). Local: "public". No Cloud: "imagens".
IMAGENS_DISK=public
# FISCAL_DISK: XML e DANFE. Se não definir, usa o FILESYSTEM_DISK.
# Deixe comentado em vez de vazio: "FISCAL_DISK=" sem valor quebra o disco.
# FISCAL_DISK=local

QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
